# Copy this file to .env (never commit .env) and fill in the keys you have.
# Every key is optional: without it, that check is shown as "not configured" and skipped.

# AI second opinion. Free key from https://console.groq.com/keys
SCAM_HUNTER_AI_API_KEY=
# Any OpenAI-compatible API works. Groq is the default:
SCAM_HUNTER_AI_BASE_URL=https://api.groq.com/openai/v1
SCAM_HUNTER_AI_MODEL=openai/gpt-oss-20b
# Hugging Face instead: SCAM_HUNTER_AI_BASE_URL=https://router.huggingface.co/v1 and a model it serves.

# Link reputation. Google: https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=
# abuse.ch URLhaus: https://auth.abuse.ch/
URLHAUS_AUTH_KEY=

# Set to False to switch off every online check (AI, link reputation and website age).
SCAM_HUNTER_ONLINE_CHECKS=True
