# Copy this file to .env.local and set the address of your Django backend.
# "localhost" on a phone means the phone itself, so use one of these instead:
#   Android emulator:        http://10.0.2.2:8000
#   iOS simulator / web:     http://localhost:8000
#   Physical phone (Expo Go): http://<your computer's LAN IP>:8000   e.g. http://192.168.1.20:8000
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
